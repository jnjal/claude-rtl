{
  "manifest_version": 3,
  "name": "Claude RTL & Font Fixer",
  "version": "2.3",
  "description": "راست‌چین کردن متن‌های فارسی و تغییر فونت کلاد به وزیرمتن",
  "permissions": ["storage"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.ttf"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
