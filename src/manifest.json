{
  "manifest_version": 3,
  "name": "Claude RTL & Font Fixer",
  "version": "1.1.0",
  "description": "راست‌چین کردن متن‌های فارسی و تغییر فونت کلاد به نسخه محلی وزیرمتن",
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "css": ["style.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.ttf"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}